@page "/jobs/{JobId:guid}"
@inject JobStore JobStore
@inject NavigationManager Nav
@inject JobQueue JobQueue
@inject IJSRuntime JS
@inject LlmSettingsService LlmSettings
@inject PromptTemplates PhaseTemplates
@inject JobPersistenceService Persistence
@inject ISnackbar Snackbar
@implements IDisposable
@namespace OpenTransmute.Components.Pages

<PageTitle>Job — OpenTransmute</PageTitle>

@if (_job is null)
{
    <MudText>Job not found.</MudText>
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-1">
    @if (_editing)
    {
        <MudTextField @bind-Value="_editProjectName" Label="Project Name"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:300px" />
    }
    else
    {
        <MudText Typo="Typo.h5">@_job.Options.ProjectName</MudText>
    }
    <MudChip T="string" Size="Size.Small" Color="@StatusColor(_job.Status)">@_job.Status</MudChip>
    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
               StartIcon="@Icons.Material.Filled.RestartAlt"
               OnClick="ResetJob">
        Reset
    </MudButton>
    @if (_job.Status is not JobStatus.Running and not JobStatus.Pending)
    {
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Replay"
                   Disabled="_rerunning"
                   OnClick="() => RequestRerun(0, null)">
            Re-run from Phase 0
        </MudButton>
    }
    @if (_job.Status is JobStatus.Running or JobStatus.Pending)
    {
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Error"
                   StartIcon="@Icons.Material.Filled.Stop"
                   OnClick="AbortJob">
            Abort
        </MudButton>
    }
    else if (_job.Status is not JobStatus.Running and not JobStatus.Pending)
    {
        @if (_editing)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Success"
                           Size="Size.Small" OnClick="SaveEditAsync" Disabled="_saving" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default"
                           Size="Size.Small" OnClick="CancelEdit" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Default"
                           Size="Size.Small" OnClick="StartEdit" />
        }
    }
</MudStack>

@if (_editing)
{
    <MudStack Spacing="2" Class="mb-4" Style="max-width:600px">
        <MudTextField @bind-Value="_editSource" Label="Source" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_editOutputRoot" Label="Output Root" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_editCloneDirectory" Label="Clone Directory"
                      Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="(system temp)" />
    </MudStack>
}
else
{
    <MudText Typo="Typo.body2" Class="mb-4">
        Source: @_job.Options.Source
        @if (_job.TotalElapsed.HasValue)
        {
            <span> · Elapsed: @_job.TotalElapsed.Value.ToString(@"mm\:ss")</span>
        }
    </MudText>
}

@if (_job.Status is not JobStatus.Running and not JobStatus.Pending)
{
    <MudExpansionPanels Elevation="1" Class="mb-4">
        <MudExpansionPanel Text="Re-run Settings — Per-Phase Configuration"
                           Icon="@Icons.Material.Filled.Tune">
            <MudText Typo="Typo.caption" Class="mb-3 mud-text-secondary">
                Override the engine or AppendResults mode for individual phases before re-running.
                Blank engine = use the original job's engine (@_job.Options.Orchestrator).
            </MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Sync"
                           OnClick="RePullModelSettingsAsync">
                    Re-pull model settings
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Refresh this job's engine, per-tier models, and token limits from the current global Settings.
                    Applies to future re-runs — needed to pick up caps changed after the job was created.
                </MudText>
            </MudStack>
            <MudSimpleTable Dense="true" Hover="true" Bordered="true">
                <thead>
                    <tr>
                        <th>Phase</th>
                        <th style="width:200px">Engine Override</th>
                        <th style="width:140px">AppendResults</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pc in _phaseConfigs)
                    {
                        <tr>
                            <td>@pc.Number — @pc.Title</td>
                            <td>
                                <MudSelect T="OrchestratorType?" @bind-Value="pc.Orchestrator"
                                           Dense="true" Variant="Variant.Text"
                                           Placeholder="(original)" Clearable="true" Margin="Margin.Dense">
                                    @foreach (var orch in Enum.GetValues<OrchestratorType>())
                                    {
                                        <MudSelectItem T="OrchestratorType?" Value="@orch">@orch</MudSelectItem>
                                    }
                                </MudSelect>
                            </td>
                            <td>
                                <MudCheckBox T="bool" @bind-Value="pc.AppendResults"
                                             Dense="true" />
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudExpansionPanel>
    </MudExpansionPanels>
}

<!-- Phase progress cards -->
<MudGrid Spacing="2" Class="mb-4">
    @foreach (var phase in _job.Phases)
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="@(phase.Status == JobStatus.Running ? 4 : 1)"
                     Style="@(phase.Status == JobStatus.Running ? "border: 2px solid #5C6BC0" : "")">
                <MudCardHeader>
                    <CardHeaderAvatar>
                        <MudIcon Icon="@PhaseCardIcon(phase)"
                                 Color="@PhaseCardColor(phase)" />
                    </CardHeaderAvatar>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle2">Phase @phase.PhaseNumber</MudText>
                        <MudText Typo="Typo.caption">@phase.PhaseName</MudText>
                    </CardHeaderContent>
                    <CardHeaderActions>
                        @if (phase.Elapsed.HasValue)
                        {
                            <MudText Typo="Typo.caption">@phase.Elapsed.Value.ToString(@"mm\:ss")</MudText>
                        }
                    </CardHeaderActions>
                </MudCardHeader>

                @if (phase.Status == JobStatus.Failed)
                {
                    <MudCardContent>
                        <MudAlert Severity="Severity.Error" Dense="true">@phase.ErrorMessage</MudAlert>
                    </MudCardContent>
                }
                else if (!string.IsNullOrWhiteSpace(phase.OutputPreview))
                {
                    <MudCardContent>
                        <MudExpansionPanel Text="Preview" Dense="true">
                            <MudText Style="white-space:pre-wrap;font-family:monospace;font-size:0.75rem">
                                @phase.OutputPreview
                            </MudText>
                        </MudExpansionPanel>
                    </MudCardContent>
                }

                @if (((phase.Status is JobStatus.Completed or JobStatus.Failed)
                      || (phase.Status == JobStatus.Pending && PhaseHasValidOutput(phase.PhaseNumber)))
                     && _job.Status is not JobStatus.Running and not JobStatus.Pending)
                {
                    <MudCardActions>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Replay"
                                   Disabled="_rerunning"
                                   OnClick="() => RequestRerun(phase.PhaseNumber, phase.PhaseNumber)">
                            Re-run phase
                        </MudButton>
                        @if (phase.PhaseNumber == 3)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.SkipNext"
                                       Disabled="_rerunning"
                                       OnClick="() => ShowExpansionResume()">
                                Resume from item…
                            </MudButton>
                        }
                        @if (PhaseHasValidOutput(phase.PhaseNumber))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                                       StartIcon="@Icons.Material.Filled.FastForward"
                                       Disabled="_rerunning"
                                       OnClick="() => RequestRerun(phase.PhaseNumber + 1, null)">
                                Continue from next
                            </MudButton>
                        }
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   StartIcon="@Icons.Material.Filled.FastForward"
                                   Disabled="_rerunning"
                                   OnClick="() => RequestRerun(phase.PhaseNumber, null)">
                            Continue from here
                        </MudButton>
                    </MudCardActions>
                }
            </MudCard>
        </MudItem>
    }
</MudGrid>

<!-- API key prompt when re-running an OpenAI job whose key wasn't persisted -->
@if (_pendingRerunPhase.HasValue)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <MudText Typo="Typo.body2" Class="mb-2">
            This job used the OpenAI orchestrator. The API key is never saved to disk — enter it to re-run from Phase @_pendingRerunPhase.
        </MudText>
        <MudTextField @bind-Value="_rerunApiKey" Label="OpenAI API Key"
                      InputType="InputType.Password" Variant="Variant.Outlined" Dense="true" />
        <MudStack Row="true" Class="mt-2" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Replay"
                       OnClick="ConfirmRerunAsync"
                       Disabled="string.IsNullOrWhiteSpace(_rerunApiKey)">
                Re-run from Phase @_pendingRerunPhase
            </MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       OnClick="() => { _pendingRerunPhase = null; _rerunApiKey = string.Empty; _rerunning = false; }">
                Cancel
            </MudButton>
        </MudStack>
    </MudAlert>
}

@if (_expansionPlan is not null && _expansionItems is null
     && _expansionPlan.Any(i => !i.Done)
     && _job.Status is not JobStatus.Running and not JobStatus.Pending)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <MudText Typo="Typo.body2" Class="mb-2">
            Partial Phase 3 detected — @_expansionPlan.Count(i => i.Done) of @_expansionPlan.Count
            component specs complete (discovery plan found on disk). Resume continues at item
            @_expansionFirstMissing without re-running finished specs.
        </MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       Disabled="_rerunning"
                       OnClick="ResumeExpansionFromFirstMissing">
                Resume Phase 3 from item @_expansionFirstMissing
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.SkipNext"
                       Disabled="_rerunning"
                       OnClick="ShowExpansionResume">
                Choose item…
            </MudButton>
        </MudStack>
    </MudAlert>
}

@if (_expansionItems is not null)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        <MudText Typo="Typo.body2" Class="mb-2">
            Phase 3 plan — @_expansionItems.Count(i => i.Done) of @_expansionItems.Count component specs complete.
            Pick where to resume; items before the chosen one are kept.
        </MudText>
        <MudSelect T="int" @bind-Value="_selectedStartItem" Label="Resume at item"
                   Dense="true" Variant="Variant.Outlined">
            @foreach (var item in _expansionItems)
            {
                <MudSelectItem T="int" Value="@item.Index">
                    @item.Index — @item.Name @(item.Done ? "(done)" : "(missing)")
                </MudSelectItem>
            }
        </MudSelect>
        <MudStack Row="true" Class="mt-2" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.SkipNext"
                       OnClick="() => RequestExpansionResume()">
                Resume from item @_selectedStartItem
            </MudButton>
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       OnClick="() => { _expansionItems = null; _rerunning = false; }">
                Cancel
            </MudButton>
        </MudStack>
    </MudAlert>
}

<!-- Live log -->
<MudText Typo="Typo.subtitle2" Class="mb-1">Live Log</MudText>
<MudPaper Elevation="1" Class="pa-3" Style="max-height:400px;overflow-y:auto;background:#1e1e1e">
    @foreach (var line in _job.GetLogSnapshot())
    {
        <div style="color:#d4d4d4;font-family:monospace;font-size:0.75rem;white-space:pre-wrap">@line</div>
    }
    <div @ref="_logBottom"></div>
</MudPaper>

@code {
    [Parameter] public Guid JobId { get; set; }

    private DecomposeJob? _job;
    private PeriodicTimer? _ticker;
    private ElementReference _logBottom;

    private Guid _loadedJobId;

    protected override void OnParametersSet()
    {
        if (_loadedJobId == JobId) return;

        // Unsubscribe from the previous job and stop its ticker
        if (_job is not null)
            _job.OnChanged -= OnJobChanged;
        _ticker?.Dispose();
        _ticker = null;
        _rerunning = false;

        _loadedJobId = JobId;
        _job = JobStore.GetDecompose(JobId);
        if (_job is not null)
        {
            _job.OnChanged += OnJobChanged;
            InitPhaseConfigs();
            RefreshDiskOutputCache();
        }

        if (_job?.Status is JobStatus.Running or JobStatus.Pending)
            _ = TickAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_job?.Status == JobStatus.Running)
            await JS.InvokeVoidAsync("scrollLogToBottom", _logBottom);
    }

    private void OnJobChanged()
    {
        if (_job?.Status is JobStatus.Completed or JobStatus.Failed)
            RefreshDiskOutputCache();

        if (_job?.Status == JobStatus.Running && _ticker is null)
            _ = TickAsync();
        InvokeAsync(StateHasChanged);
    }

    private async Task TickAsync()
    {
        _ticker = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await _ticker.WaitForNextTickAsync())
            {
                if (_job?.Status is not JobStatus.Running and not JobStatus.Pending) break;
                await InvokeAsync(StateHasChanged);
            }
        }
        finally
        {
            _ticker.Dispose();
            _ticker = null;
        }
    }

    private bool _rerunning;
    private List<PhaseConfig> _phaseConfigs = new();
    private int? _pendingRerunPhase;
    private int? _pendingRerunEndPhase;
    private string _rerunApiKey = string.Empty;

    // Expansion resume state
    private List<ExpansionFileInfo>? _expansionItems;
    private int _selectedStartItem = 1;

    // Auto-detected Phase 3 plan from 03-00-discovery.json (null = no discovery on disk).
    private List<ExpansionFileInfo>? _expansionPlan;
    private int _expansionFirstMissing = 1;

    // Edit mode state
    private bool _editing;
    private bool _saving;
    private string _editProjectName = string.Empty;
    private string _editSource = string.Empty;
    private string _editOutputRoot = string.Empty;
    private string _editCloneDirectory = string.Empty;

    // Cached per-phase on-disk output flags — avoids repeated filesystem scans during render.
    private readonly HashSet<int> _diskOutputPhases = new();

    private record ExpansionFileInfo(int Index, string Name, bool Done);

    /// <summary>Mutable row backing the per-phase configuration table.</summary>
    private sealed class PhaseConfig
    {
        public int Number { get; init; }
        public string Title { get; init; } = string.Empty;
        public OrchestratorType? Orchestrator { get; set; }
        public bool AppendResults { get; set; }
    }

    /// <summary>
    /// Populates the per-phase config list from the template phases,
    /// restoring any overrides that were saved on the current job.
    /// </summary>
    private void InitPhaseConfigs()
    {
        Dictionary<int, PhaseOverride>? existing = _job!.Options.PhaseOverrides;
        _phaseConfigs = PhaseTemplates.Phases.Select(p =>
        {
            PhaseOverride? ov = null;
            existing?.TryGetValue(p.Number, out ov);
            return new PhaseConfig
            {
                Number = p.Number,
                Title = p.Title,
                Orchestrator = ov?.Orchestrator,
                AppendResults = ov?.UseAppendResults == true
            };
        }).ToList();
    }

    private void RequestRerun(int phase, int? endPhase)
    {
        if (_job is null || _rerunning) return;
        _rerunning = true;

        // Check whether any phase in the re-run range will use OpenAI and needs a key.
        bool needsOpenAiKey = NeedsOpenAiKey(phase, endPhase);
        if (needsOpenAiKey &&
            string.IsNullOrEmpty(_job.Options.OpenAiApiKey) &&
            string.IsNullOrEmpty(LlmSettings.OpenAiApiKey))
        {
            _pendingRerunPhase = phase;
            _pendingRerunEndPhase = endPhase;
            return;
        }
        _ = RerunAsync(phase, endPhase, null);
    }

    /// <summary>
    /// Returns true when any phase in [start..end] resolves to OpenAI, meaning
    /// we need an API key before we can run.
    /// </summary>
    private bool NeedsOpenAiKey(int startPhase, int? endPhase)
    {
        OrchestratorType globalOrch = _job!.Options.Orchestrator;
        foreach (PhaseConfig pc in _phaseConfigs)
        {
            if (pc.Number < startPhase) continue;
            if (endPhase.HasValue && pc.Number > endPhase.Value) continue;
            OrchestratorType effective = pc.Orchestrator ?? globalOrch;
            if (effective == OrchestratorType.OpenAI) return true;
        }
        return false;
    }

    private async Task ConfirmRerunAsync()
    {
        if (_pendingRerunPhase is null || _job is null) return;
        var phase    = _pendingRerunPhase.Value;
        var endPhase = _pendingRerunEndPhase;
        var key      = _rerunApiKey;
        _pendingRerunPhase    = null;
        _pendingRerunEndPhase = null;
        _rerunApiKey          = string.Empty;
        await RerunAsync(phase, endPhase, key);
    }

    private DecomposeOptions BuildRerunOptions(
        int startPhase, int? endPhase, int? startItem = null, string? apiKeyOverride = null)
    {
        var o = _job!.Options;

        // Build per-phase overrides from the UI config table.
        Dictionary<int, PhaseOverride> overrides = new();
        foreach (PhaseConfig pc in _phaseConfigs)
        {
            PhaseOverride po = new()
            {
                Orchestrator = pc.Orchestrator,
                UseAppendResults = pc.AppendResults ? true : null
            };
            if (!po.IsEmpty)
                overrides[pc.Number] = po;
        }

        // If any per-phase override changes the engine, pull model/key from global settings.
        bool anyEngineOverride = _phaseConfigs.Any(pc => pc.Orchestrator is not null);

        return new DecomposeOptions
        {
            Source                 = o.Source,
            ProjectName            = o.ProjectName,
            Orchestrator           = o.Orchestrator,
            ThickModel             = anyEngineOverride ? LlmSettings.ThickModel ?? o.ThickModel : o.ThickModel,
            RegularModel           = anyEngineOverride ? LlmSettings.RegularModel ?? o.RegularModel : o.RegularModel,
            ThinModel              = anyEngineOverride ? LlmSettings.ThinModel ?? o.ThinModel : o.ThinModel,
            OpenAiApiKey           = apiKeyOverride ?? LlmSettings.OpenAiApiKey ?? o.OpenAiApiKey,
            OpenAiEndpoint         = anyEngineOverride ? LlmSettings.OpenAiEndpoint ?? o.OpenAiEndpoint : o.OpenAiEndpoint,
            StartPhase             = startPhase,
            StartItem              = startItem,
            EndPhase               = endPhase,
            OutputRoot             = o.OutputRoot,
            MaxOutputTokens        = o.MaxOutputTokens,
            ThickMaxOutputTokens   = o.ThickMaxOutputTokens,
            RegularMaxOutputTokens = o.RegularMaxOutputTokens,
            ThinMaxOutputTokens    = o.ThinMaxOutputTokens,
            ContextTier            = o.ContextTier,
            MaxTurns               = o.MaxTurns,
            TimeoutMinutes         = o.TimeoutMinutes,
            KeepClone              = o.KeepClone,
            CloneDirectory         = o.CloneDirectory,
            Hints                  = o.Hints,
            PhaseOverrides         = overrides.Count > 0 ? overrides : null,
        };
    }

    private async Task RerunAsync(int phase, int? endPhase, string? apiKeyOverride)
    {
        if (_job is null) { _rerunning = false; return; }
        var newJob = new DecomposeJob { Options = BuildRerunOptions(phase, endPhase, apiKeyOverride: apiKeyOverride) };
        JobStore.Add(newJob);
        await JobQueue.EnqueueAsync(newJob);
        Nav.NavigateTo($"/jobs/{newJob.Id}");
    }

    private void ShowExpansionResume()
    {
        if (_job is null) return;
        _rerunning = true;

        List<ExpansionFileInfo>? plan = _expansionPlan ??= ScanExpansionPlan();
        if (plan is null || plan.Count == 0)
        {
            // No discovery JSON on disk — there is no sub-phase plan to resume from.
            _rerunning = false;
            RequestRerun(3, 3);
            return;
        }

        _expansionItems = plan;
        _selectedStartItem = plan.FirstOrDefault(i => !i.Done)?.Index ?? plan[^1].Index;
    }

    /// <summary>
    /// Reads 03-00-discovery.json and pairs each planned component group with its on-disk
    /// spec file (03-{index:00}-*.md, non-empty). Returns the ordered plan with a Done flag
    /// per item, or null when no discovery file exists or it cannot be parsed.
    /// </summary>
    private List<ExpansionFileInfo>? ScanExpansionPlan()
    {
        if (_job is null) return null;

        string dir = System.IO.Path.Combine(_job.Options.OutputRoot, "Output", "Decomposition", _job.Options.ProjectName);
        string discoveryPath = System.IO.Path.Combine(dir, "03-00-discovery.json");
        if (!File.Exists(discoveryPath)) return null;

        try
        {
            string json = File.ReadAllText(discoveryPath);

            // Use the orchestrator's own lenient parser so the resume planner agrees with the
            // live run. A strict array parse here silently failed on fence-wrapped discovery
            // JSON, collapsing "resume from item" into a full-phase re-run.
            IReadOnlyList<string>? names = OpenTransmute.Orchestration.JobOrchestrator.TryParseDiscoveryGroupNames(json);
            if (names is null || names.Count == 0) return null;

            List<ExpansionFileInfo> plan = new(names.Count);
            for (int i = 0; i < names.Count; i++)
            {
                int index = i + 1;
                plan.Add(new ExpansionFileInfo(index, names[i], ExpansionItemOnDisk(dir, index)));
            }

            return plan;
        }
        catch (Exception)
        {
            // Unreadable discovery file — treat as "no resume info" rather than guessing.
            return null;
        }
    }

    /// <summary>True when a non-empty spec file (03-{index:00}-*.md) exists for the item.</summary>
    private static bool ExpansionItemOnDisk(string dir, int index)
    {
        if (!Directory.Exists(dir)) return false;
        foreach (string file in Directory.EnumerateFiles(dir, $"03-{index:00}-*.md"))
        {
            if (new FileInfo(file).Length > 0) return true;
        }
        return false;
    }

    /// <summary>Resumes Phase 3 at the first missing component spec, keeping completed items.</summary>
    private void ResumeExpansionFromFirstMissing()
    {
        if (_job is null || _rerunning) return;
        _rerunning = true;
        _ = RerunWithStartItemAsync(3, 3, _expansionFirstMissing);
    }

    private void RequestExpansionResume()
    {
        if (_job is null) return;
        _expansionItems = null;
        // Delegate to the standard re-run with StartItem set
        _ = RerunWithStartItemAsync(3, 3, _selectedStartItem);
    }

    private async Task RerunWithStartItemAsync(int phase, int? endPhase, int startItem)
    {
        if (_job is null) { _rerunning = false; return; }
        var newJob = new DecomposeJob { Options = BuildRerunOptions(phase, endPhase, startItem: startItem) };
        JobStore.Add(newJob);
        await JobQueue.EnqueueAsync(newJob);
        Nav.NavigateTo($"/jobs/{newJob.Id}");
    }

    private void AbortJob()
    {
        if (_job is null) return;

        if (_job.Status is JobStatus.Running)
        {
            _job.Abort();
            _job.AppendLog("Abort requested by user.");
        }
        else
        {
            // Pending or stuck from a previous run — force to Failed immediately.
            _job.ForceFail("Aborted by user.");
        }
    }

    /// <summary>
    /// Clears a wedged job: stops any spinning phase, forces the job back to a clean Failed
    /// state, and persists. Use when a run died abnormally (e.g. output deleted mid-run) and
    /// the UI is stuck with a Failed badge but a phase still showing Running. Works regardless
    /// of current status, unlike Abort/ForceFail which no-op on an already-Failed job.
    /// </summary>
    private async Task ResetJob()
    {
        if (_job is null) return;

        _job.Reset();
        _rerunning = false;       // release any latched re-run guard from the dead attempt
        _expansionItems = null;   // drop stale resume-dialog state

        try
        {
            await Persistence.SaveAsync(_job);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Reset applied in memory, but saving failed: {ex.Message}", Severity.Warning);
            return;
        }

        Snackbar.Add("Job reset — stuck phases cleared. You can re-run now.", Severity.Success);
    }

    private void StartEdit()
    {
        if (_job is null) return;
        _editProjectName = _job.Options.ProjectName;
        _editSource = _job.Options.Source;
        _editOutputRoot = _job.Options.OutputRoot;
        _editCloneDirectory = _job.Options.CloneDirectory ?? string.Empty;
        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
    }

    /// <summary>
    /// Copies the current global LLM settings (engine, per-tier models, endpoint, and all
    /// token limits) onto this job's stored options and persists them. Re-runs read models
    /// and token limits straight off the job, so this is how an existing job picks up
    /// settings changed after it was created — e.g. a raised Phase 3 (thick) token cap.
    /// The API key is intentionally left alone; the re-run flow pulls it live when needed.
    /// </summary>
    private async Task RePullModelSettingsAsync()
    {
        if (_job is null) return;

        DecomposeOptions o = _job.Options;
        o.Orchestrator           = LlmSettings.Orchestrator;
        o.ThickModel             = LlmSettings.ThickModel;
        o.RegularModel           = LlmSettings.RegularModel;
        o.ThinModel              = LlmSettings.ThinModel;
        o.OpenAiEndpoint         = LlmSettings.OpenAiEndpoint;
        o.MaxOutputTokens        = LlmSettings.MaxOutputTokens;
        o.ThickMaxOutputTokens   = LlmSettings.ThickMaxOutputTokens;
        o.RegularMaxOutputTokens = LlmSettings.RegularMaxOutputTokens;
        o.ThinMaxOutputTokens    = LlmSettings.ThinMaxOutputTokens;
        o.ContextTier            = LlmSettings.ContextTier;
        o.MaxTurns               = LlmSettings.MaxTurns;
        o.TimeoutMinutes         = LlmSettings.TimeoutMinutes;

        await Persistence.SaveAsync(_job);
        Snackbar.Add(
            $"Pulled current model settings — engine {o.Orchestrator}, thick cap {o.ThickMaxOutputTokens:N0} tokens.",
            Severity.Success);

        _job.NotifyChanged();
    }

    private async Task SaveEditAsync()
    {
        if (_job is null) return;
        _saving = true;

        string oldProjectName = _job.Options.ProjectName;

        _job.Options.ProjectName = _editProjectName.Trim();
        _job.Options.Source = _editSource.Trim();
        _job.Options.OutputRoot = _editOutputRoot.Trim();
        _job.Options.CloneDirectory = string.IsNullOrWhiteSpace(_editCloneDirectory)
            ? null
            : _editCloneDirectory.Trim();

        await Persistence.SaveAsync(_job);

        // If the project name changed, clean up the old job.json at the previous path.
        if (!string.Equals(oldProjectName, _job.Options.ProjectName, StringComparison.Ordinal))
            Persistence.DeleteJobFile(_job.Options.OutputRoot, oldProjectName);

        _editing = false;
        _saving = false;
        _job.NotifyChanged();
    }

    private static Color StatusColor(JobStatus s) => s switch
    {
        JobStatus.Completed => Color.Success,
        JobStatus.Failed => Color.Error,
        JobStatus.Running => Color.Info,
        _ => Color.Default
    };

    private static string PhaseIcon(JobStatus s) => s switch
    {
        JobStatus.Completed => Icons.Material.Filled.CheckCircle,
        JobStatus.Failed => Icons.Material.Filled.Error,
        JobStatus.Running => Icons.Material.Filled.HourglassTop,
        _ => Icons.Material.Filled.RadioButtonUnchecked
    };

    private static Color PhaseIconColor(JobStatus s) => s switch
    {
        JobStatus.Completed => Color.Success,
        JobStatus.Failed => Color.Error,
        JobStatus.Running => Color.Primary,
        _ => Color.Default
    };

    /// <summary>
    /// Returns the appropriate icon for a phase card, accounting for on-disk
    /// output from prior runs when this job didn't execute the phase.
    /// </summary>
    private string PhaseCardIcon(PhaseProgress phase)
    {
        if (phase.Status != JobStatus.Pending)
            return PhaseIcon(phase.Status);

        return PhaseHasValidOutput(phase.PhaseNumber)
            ? Icons.Material.Outlined.CheckCircle
            : Icons.Material.Filled.RadioButtonUnchecked;
    }

    /// <summary>
    /// Returns the icon color for a phase card, using a muted tone for
    /// phases that have on-disk output but were not part of this job.
    /// </summary>
    private Color PhaseCardColor(PhaseProgress phase)
    {
        if (phase.Status != JobStatus.Pending)
            return PhaseIconColor(phase.Status);

        return PhaseHasValidOutput(phase.PhaseNumber)
            ? Color.Tertiary
            : Color.Default;
    }

    /// <summary>
    /// Returns true if the phase has at least one output file on disk over 1KB,
    /// indicating it completed with real content and can safely be skipped.
    /// Uses a cached set populated at load time to avoid repeated filesystem scans.
    /// </summary>
    private bool PhaseHasValidOutput(int phaseNumber) => _diskOutputPhases.Contains(phaseNumber);

    /// <summary>
    /// Scans the output directory once and caches which phases have valid files on disk.
    /// Called when the job loads and after re-runs complete.
    /// </summary>
    private void RefreshDiskOutputCache()
    {
        _diskOutputPhases.Clear();
        if (_job is null) return;

        string dir = System.IO.Path.Combine(_job.Options.OutputRoot, "Output", "Decomposition", _job.Options.ProjectName);
        if (!Directory.Exists(dir)) return;

        for (int phase = 0; phase <= 7; phase++)
        {
            string prefix = $"{phase:D2}-";
            bool hasOutput = Directory.GetFiles(dir, $"{prefix}*.md")
                .Any(f => new FileInfo(f).Length >= 1024);
            if (hasOutput)
                _diskOutputPhases.Add(phase);
        }

        // Build the Phase 3 resume plan from the discovery JSON (if any) so the UI can
        // detect a partial expansion run and skip the specs already on disk.
        _expansionPlan = ScanExpansionPlan();
        _expansionFirstMissing = _expansionPlan?.FirstOrDefault(i => !i.Done)?.Index
            ?? ((_expansionPlan?.Count ?? 0) + 1);
    }

    public void Dispose()
    {
        if (_job is not null)
            _job.OnChanged -= OnJobChanged;
        _ticker?.Dispose();
    }
}
